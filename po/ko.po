msgid ""
msgstr ""
"Project-Id-Version: shell-easy-uninstaller\n"
"Language: ko\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Uninstall"
msgstr "제거"

msgid "Uninstalling package: %s"
msgstr "패키지 제거 중: %s"

msgid "Uninstalling Flatpak: %s"
msgstr "Flatpak 제거 중: %s"

msgid "Uninstalling Snap: %s"
msgstr "Snap 제거 중: %s"

msgid "Command: %s"
msgstr "명령: %s"

msgid "Shell Easy Uninstaller"
msgstr "Shell Easy Uninstaller"

msgid "Could not determine Snap name for %s"
msgstr "%s의 Snap 이름을 확인할 수 없습니다"

msgid "Uninstallation completed successfully."
msgstr "제거를 완료했습니다."

msgid "Uninstallation failed: %s"
msgstr "제거 실패: %s"

msgid "Error launching uninstaller: %s"
msgstr "제거 프로그램 실행 오류: %s"

msgid "Could not determine the package that provides %s"
msgstr "%s을(를) 제공하는 패키지를 확인할 수 없습니다"

msgid "No supported package manager was found to uninstall %s"
msgstr "%s을(를) 제거할 수 있는 지원되는 패키지 관리자를 찾을 수 없습니다"

msgid "Uninstall %s?"
msgstr "%s을(를) 제거하시겠습니까?"

msgid "Package type: %s"
msgstr "패키지 유형: %s"

msgid "Package: %s"
msgstr "패키지: %s"

msgid "System package (%s)"
msgstr "시스템 패키지 (%s)"

msgid "Remove configuration files"
msgstr "설정 파일 제거"

msgid "Remove configuration files (not supported for this package)"
msgstr "설정 파일 제거 (이 패키지에서는 지원되지 않음)"

msgid "Cancel"
msgstr "취소"

msgid "Confirm before uninstalling"
msgstr "제거하기 전에 확인"

msgid "Show a dialog with the package details before removing an app."
msgstr "앱을 제거하기 전에 패키지 정보가 담긴 대화 상자를 표시합니다."

msgid "Uninstalling AppImage: %s"
msgstr "AppImage 제거 중: %s"

msgid "Launcher: %s"
msgstr "실행기: %s"

msgid "Delete permanently instead of moving to Trash"
msgstr "휴지통으로 이동하지 않고 영구 삭제"

msgid "Delete permanently (these files cannot be moved to Trash)"
msgstr "영구 삭제 (이 파일들은 휴지통으로 이동할 수 없음)"
